# PiVPN OpenVPN client config template
# ─────────────────────────────────────
# Replace all YOUR_* placeholders before use.
# Place the completed file at: /etc/openvpn/client/pivpn.conf
#
# This was generated by a self-hosted PiVPN server.
# See https://www.pivpn.io/ for setup instructions.

client
dev tun
proto udp
remote YOUR_VPN_SERVER_IP_OR_HOSTNAME 1194
resolv-retry infinite
nobind
remote-cert-tls server
tls-version-min 1.2
verify-x509-name YOUR_PIVPN_SERVER_NAME name
data-ciphers AES-256-GCM
auth SHA256
auth-nocache
verb 3

# Suppress Windows-only option pushed by server
pull-filter ignore "block-outside-dns"

# Survive network hiccups
persist-key
persist-tun
ping 10
ping-restart 60
explicit-exit-notify 2

# Disable kernel DCO so tun0 persists across reconnects
disable-dco

<ca>
# Paste your CA certificate here (from your PiVPN server's easy-rsa PKI)
# -----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----
</ca>

<cert>
# Paste your client certificate here
# -----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----
</cert>

<key>
# Paste your client private key here
# If key is encrypted, also add the askpass directive below
# -----BEGIN ENCRYPTED PRIVATE KEY-----
# ...
# -----END ENCRYPTED PRIVATE KEY-----
</key>

<tls-crypt>
# Paste your TLS crypt key here (from /etc/openvpn/server/ta.key on the server)
# -----BEGIN OpenVPN Static key V1-----
# ...
# -----END OpenVPN Static key V1-----
</tls-crypt>

# Password file for encrypted private key (one line, the passphrase)
# Create with: sudo nano /etc/openvpn/client/pivpn.askpass
# Set permissions: sudo chmod 600 /etc/openvpn/client/pivpn.askpass
askpass /etc/openvpn/client/pivpn.askpass
